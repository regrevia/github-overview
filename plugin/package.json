{
  "name": "dsh-github-overview",
  "version": "0.2.11",
  "description": "Reads the local GitHub Overview dashboard inside the agent: traffic, unique visitors, clones, npm downloads, the funnel, per-repository rows and external contributions.",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "engines": {
    "dsh": ">=0.1.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/regrevia/github-overview.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/regrevia/github-overview#readme",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "github",
    "traffic",
    "analytics",
    "npm-downloads"
  ],
  "exports": {
    ".": "./index.js",
    "./locale/*": "./locale/*",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.svg",
    "README.md"
  ]
}
